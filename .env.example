# Development-only proxy; never store PLC or database passwords here.
SCADA_PROXY_TARGET=http://127.0.0.1:8080
# Optional default API. The data source must be explicitly selected in the UI.
# VITE_SCADA_API=/backend/data_third.php

# Public Pages interface. No data service is published by default.
# VITE_PUBLIC_SITE=true
# VITE_API_ROOT=https://your-authorized-data-service.example/api

# Cloud simulation deployment (independent from XAMPP):
# VITE_API_ROOT=/api
# VITE_DATA_SOURCE=simulation
